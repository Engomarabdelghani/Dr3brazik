# Copy this file to .env and fill in your real values.

# Base URL of the Node API (server/). Locally the Vite dev server proxies /api to it,
# so leave the default. In production set the absolute URL, e.g.
#   VITE_API_BASE_URL=https://server.commerciallightingorlando.com/api
# (client/.env.production already sets it for `npm run build`.)
# The sitemap script (npm run build) needs the absolute URL to include products.
VITE_API_BASE_URL=/api

# development | staging | production
VITE_APP_ENV=development
